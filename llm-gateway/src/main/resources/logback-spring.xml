<configuration>
    <!-- %rmsg = the log message after secret and PII redaction (RedactingMessageConverter). -->
    <conversionRule conversionWord="rmsg" converterClass="dev.finrag.gateway.security.RedactingMessageConverter"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%X{requestId:-}] %logger{36} : %rmsg%n%throwable</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
